    {
      "beat_id": 4,
      "text": "By calculating the sigmoid of the dot product, we treat context as a dot product field to optimize.",
      "visual_focus": "A geometric dot product projection turning into a scalar probability.",
      "highlight_words": {
        "sigmoid": "#F59E0B",
        "dot product": "#F59E0B"
      },
      "svo_action": {
        "subject": "Dot Product",
        "action_verb": "saturates",
        "direct_object": "logistic probability",
        "anchor_word": "sigmoid",
        "semantic_role": "agent_action"
      },
      "visual_blueprint": {
        "layout": "chalkboard_code_block",
        "title": "KERNEL CODE: WORD2VEC: SKIP-GRA",
        "sub": "A geometric dot product projection turning into a scalar probabil",
        "params": {
          "title": "KERNEL CODE: WORD2VEC: SKIP-GRA",
          "sub": "A geometric dot product projection turning into a scalar probabil",
          "filename": "skipgram_ns.py",
          "language": "python",
          "lines": [
            "def skipgram_objective(pos_pair, neg_samples):",
            "dot_score = dot(w_target, w_context)",
            "pos_loss = -log(sigmoid(dot_score))",
            "neg_loss = -sum(log(sigmoid(-dot_n)))",
            "return pos_loss + neg_loss"
          ],
