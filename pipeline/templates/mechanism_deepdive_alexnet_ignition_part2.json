      "beat_id": 3,
      "text": "The ReLU pivot replaces non-linear curves with a piecewise linear switch, firing gradients forward at a constant rate.",
      "visual_focus": "A sharp, angular activation function turning on inputs at zero.",
      "highlight_words": {
        "ReLU": "#34D399",
        "pivot": "#34D399"
      },
      "svo_action": {
