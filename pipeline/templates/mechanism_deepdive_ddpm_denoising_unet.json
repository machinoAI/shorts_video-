        },
        {
          "term": "\\epsilon_\\theta",
          "label": "Predicted Noise"
        }
      ],
      "svg_filename": "ddpm_denoising_unet_beat1_formula.svg"
    },
    {
      "beat_id": 2,
      "latex": "$x_t = \\sqrt{\\bar{\\alpha}_t} x_0 + \\sqrt{1 - \\bar{\\alpha}_t} \\epsilon$",
      "filename": "ddpm_denoising_unet_beat2_formula.svg",
      "fontsize": 24,
      "color": "#EF4444",
      "term_annotations": [
        {
          "term": "x_t",
          "label": "Noisy Input"
        },
        {
          "term": "\\bar{\\alpha}_t",
          "label": "Noise Schedule"
        }
      ],
      "svg_filename": "ddpm_denoising_unet_beat2_formula.svg"
    },
    {
      "beat_id": 3,
      "latex": "$p_\\theta(x_{t-1}|x_t) = \\mathcal{N}(x_{t-1}; \\mu_\\theta(x_t, t), \\sigma^2_t I)$",
      "filename": "ddpm_denoising_unet_beat3_formula.svg",
      "fontsize": 24,
      "color": "#34D399",
      "term_annotations": [
        {
          "term": "\\mu_\\theta",
          "label": "Mean Prediction"
        },
