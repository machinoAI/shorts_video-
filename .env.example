# machinoAI — Environment Configuration Template

# Channel Identity
CHANNEL_NAME="machinoAI"
CHANNEL_HANDLE="@machinoai-in"
CHANNEL_URL="https://www.youtube.com/@machinoai-in"
CHANNEL_WEBSITE="https://machinoai.in"
CHANNEL_TAGLINE="Learn from research papers"
CHANNEL_DESCRIPTION="We're building the future of tools and technology insights, one precision-crafted solution at a time."
CHANNEL_BRAND_COLOR="#10B981"

# LLM Configuration (Gemini primary, Groq fallback)
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-flash-latest"
GROQ_API_KEY=""
LLM_PROVIDER="gemini"

# TTS Configuration (Free local Kokoro-82M ONNX)
TTS_PROVIDER="kokoro"
# Options: am_adam (3Blue1Brown/Grant Sanderson style), am_eric (crisp tech), am_michael (warm documentary), af_heart (crystal clear female), bm_george (British documentary)
KOKORO_VOICE="am_adam"

# YouTube Publishing
YOUTUBE_CLIENT_SECRETS_PATH="pipeline/client_secrets.json"
YOUTUBE_TOKEN_PATH="pipeline/youtube_token.json"

# Optional Cloud Overrides
# FFMPEG_BIN="/opt/homebrew/bin/ffmpeg"
